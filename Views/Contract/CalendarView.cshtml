@{
    ViewData["Title"] = "Lịch thuê phòng";
}

<style>
    .calendar-page {
        max-width: 1480px;
        margin: 0 auto;
    }

    .calendar-title {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 18px;
    }

    .calendar-title h4 {
        margin: 0;
        font-weight: 750;
        color: #172033;
    }

    .calendar-title .title-icon {
        width: 38px;
        height: 38px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        background: #dff3e8;
        color: #1f7a5a;
    }

    .cal-stat-card .card-body {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 16px 18px;
    }

    .cal-stat-icon {
        width: 42px;
        height: 42px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        background: #f2f4f7;
        flex-shrink: 0;
    }

    .cal-stat-value {
        font-size: 1.55rem;
        line-height: 1;
        font-weight: 800;
    }

    .cal-stat-label {
        margin-top: 5px;
        color: #667085;
        font-size: .82rem;
        font-weight: 600;
    }

    .calendar-toolbar .card-body {
        min-height: 58px;
        padding: 10px 14px;
    }

    .month-pill {
        min-width: 150px;
        text-align: center;
        font-size: 1rem;
        font-weight: 750;
        color: #172033;
    }

    .legend-dot {
        width: 18px;
        height: 9px;
        border-radius: 999px;
        display: inline-block;
    }

    .legend-line {
        width: 2px;
        height: 16px;
        background: #ef4444;
        display: inline-block;
    }

    .cal-shell {
        overflow: hidden;
        border-radius: 8px;
        border: 1px solid #e5e9f2;
        background: #fff;
        box-shadow: 0 14px 34px rgba(17, 24, 39, .08);
    }

    .cal-wrap {
        overflow: auto;
        max-height: calc(100vh - 300px);
        min-height: 500px;
    }

    .cal-grid {
        min-width: 960px;
        font-size: 13px;
    }

    .cal-hdr-row,
    .cal-room-row {
        display: flex;
        align-items: stretch;
        border-bottom: 1px solid #eef2f7;
    }

    .cal-room-row {
        min-height: 82px;
        background: #fff;
    }

    .cal-room-row:hover {
        background: #fbfcff;
    }

    .cal-room-row:hover > .cal-room-col {
        background: #f8fbff;
    }

    .cal-room-col {
        width: 220px;
        min-width: 220px;
        padding: 12px 14px;
        background: #fff;
        border-right: 1px solid #dce4f0;
        position: sticky;
        left: 0;
        z-index: 10;
        display: flex;
        flex-direction: column;
        justify-content: center;
        transition: background .15s;
    }

    .cal-hdr-row .cal-room-col {
        min-height: 46px;
        font-weight: 800;
        font-size: 11px;
        letter-spacing: .04em;
        color: #667085;
        text-transform: uppercase;
        z-index: 21;
        background: #f8fafc;
    }

    .cal-days-area {
        flex: 1;
        display: flex;
        position: relative;
        min-width: 0;
    }

    .cal-day-hdr {
        flex: 1;
        min-width: 38px;
        text-align: center;
        padding: 7px 0 6px;
        border-right: 1px solid #eef2f7;
        font-weight: 800;
        font-size: 13px;
        color: #344054;
        background: #f8fafc;
    }

    .cal-day-hdr .dow {
        font-size: 10px;
        font-weight: 700;
        color: #98a2b3;
        display: block;
        margin-bottom: 2px;
    }

    .cal-day-hdr.today {
        background: #dff3e8;
        color: #1f7a5a;
    }

    .cal-day-hdr.weekend {
        color: #b54708;
        background: #fffbf3;
    }

    .cal-bg-cells {
        position: absolute;
        inset: 0;
        display: flex;
        pointer-events: none;
        z-index: 0;
    }

    .cal-bg-cell {
        flex: 1;
        min-width: 38px;
        border-right: 1px solid #f1f4f9;
    }

    .cal-bg-cell.today {
        background: rgba(37, 86, 217, .08);
    }

    .cal-bg-cell.weekend {
        background: rgba(247, 144, 9, .035);
    }

    .cal-bar {
        position: absolute;
        top: 18px;
        height: 46px;
        border-radius: 8px;
        cursor: pointer;
        display: flex;
        align-items: center;
        min-width: 44px;
        padding: 0 12px;
        overflow: hidden;
        z-index: 2;
        box-shadow: 0 8px 20px rgba(37, 86, 217, .22);
        transition: transform .16s ease, box-shadow .16s ease, filter .16s ease;
    }

    .cal-bar:hover {
        filter: brightness(1.04);
        box-shadow: 0 12px 28px rgba(37, 86, 217, .28);
        transform: translateY(-1px);
        z-index: 5;
    }

    .cal-bar.ended {
        box-shadow: 0 8px 18px rgba(52, 64, 84, .16);
    }

    .cal-bar-content {
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .cal-bar .bar-name {
        color: #fff;
        font-size: 12px;
        font-weight: 800;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .cal-bar .bar-dates {
        color: rgba(255, 255, 255, .78);
        font-size: 10px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .cal-today-line {
        position: absolute;
        top: 0;
        bottom: 0;
        width: 2px;
        background: #ef4444;
        z-index: 4;
        pointer-events: none;
    }

    .cal-today-line::before,
    .cal-today-line::after {
        content: '';
        position: absolute;
        left: -4px;
        width: 10px;
        height: 10px;
        background: #ef4444;
        border-radius: 50%;
        box-shadow: 0 0 0 3px rgba(239, 68, 68, .12);
    }

    .cal-today-line::before { top: 6px; }
    .cal-today-line::after { bottom: 6px; }

    .cal-empty-lbl {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        padding-left: 18px;
        color: #98a2b3;
        font-size: 12px;
        font-style: italic;
        pointer-events: none;
        z-index: 1;
    }

    .room-name {
        font-weight: 800;
        font-size: 14px;
        color: #172033;
        margin-bottom: 2px;
    }

    .room-meta {
        font-size: 11px;
        color: #667085;
        line-height: 1.3;
    }

    .room-price {
        font-size: 12px;
        color: #079455;
        font-weight: 800;
        margin-top: 3px;
    }

    .room-status-pill {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: fit-content;
        min-width: 92px;
        margin-top: 7px;
        padding: 3px 10px;
        border-radius: 999px;
        font-size: 10px;
        font-weight: 800;
    }

    .room-status-pill.available { color: #067647; background: #dcfae6; }
    .room-status-pill.pending { color: #b54708; background: #fef0c7; }
    .room-status-pill.occupied { color: #b42318; background: #fee4e2; }

    .info-group {
        background:#f8fafc;
        border:1px solid #e5e7eb;
        border-radius:8px;
        padding:14px 18px;
        margin-bottom:14px;
    }

    .info-group-title {
        font-weight:700;
        font-size:13px;
        color:#374151;
        margin-bottom:12px;
        display:flex;
        align-items:center;
        gap:7px;
        border-bottom:1px solid #e5e7eb;
        padding-bottom:8px;
    }

    .info-grid { display:grid; grid-template-columns:1fr 1fr; gap:8px 20px; }
    .info-item { display:flex; flex-direction:column; gap:2px; }
    .info-item.span-2 { grid-column:span 2; }
    .info-label { font-size:11px; color:#9ca3af; font-weight:700; text-transform:uppercase; }
    .info-value { font-size:13px; color:#1e293b; font-weight:600; }
    .info-value.muted { color:#9ca3af; font-style:italic; }
    .info-value.money { color:#079455; font-weight:800; }

    @@media (max-width: 767.98px) {
        .cal-wrap { max-height: calc(100vh - 360px); }
        .calendar-toolbar .card-body { align-items: stretch !important; }
        .calendar-toolbar select { width: 100% !important; }
        .calendar-legend { width: 100%; justify-content: space-between; }
    }
</style>

<div class="calendar-page">
    <div class="calendar-title">
        <span class="title-icon"><i class="fas fa-calendar-days"></i></span>
        <div>
            <h4>Lịch trạng thái thuê phòng</h4>
            <div class="page-subtitle">Theo dõi tình trạng phòng theo tháng, hợp đồng đang thuê và các mốc hết hạn.</div>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-6 col-xl-3">
            <div class="card cal-stat-card h-100">
                <div class="card-body">
                    <span class="cal-stat-icon text-primary"><i class="fas fa-door-open"></i></span>
                    <div>
                        <div class="cal-stat-value text-primary" id="statTotal">—</div>
                        <div class="cal-stat-label">Tổng phòng</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="card cal-stat-card h-100">
                <div class="card-body">
                    <span class="cal-stat-icon text-danger"><i class="fas fa-user-check"></i></span>
                    <div>
                        <div class="cal-stat-value text-danger" id="statOccupied">—</div>
                        <div class="cal-stat-label">Đang có người thuê</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="card cal-stat-card h-100">
                <div class="card-body">
                    <span class="cal-stat-icon text-success"><i class="fas fa-circle-check"></i></span>
                    <div>
                        <div class="cal-stat-value text-success" id="statAvailable">—</div>
                        <div class="cal-stat-label">Phòng trống</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="card cal-stat-card h-100">
                <div class="card-body">
                    <span class="cal-stat-icon text-warning"><i class="fas fa-money-bill-wave"></i></span>
                    <div>
                        <div class="cal-stat-value text-success" id="statRevenue" style="font-size:1.05rem">—</div>
                        <div class="cal-stat-label">Doanh thu tháng</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card calendar-toolbar mb-3">
        <div class="card-body d-flex flex-wrap gap-3 align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-2">
                <button class="btn btn-sm btn-outline-primary" onclick="prevMonth()" title="Tháng trước"><i class="fas fa-chevron-left"></i></button>
                <span id="monthLabel" class="month-pill">...</span>
                <button class="btn btn-sm btn-outline-primary" onclick="nextMonth()" title="Tháng sau"><i class="fas fa-chevron-right"></i></button>
                <button class="btn btn-sm btn-secondary" onclick="goToday()"><i class="fas fa-crosshairs me-1"></i>Hôm nay</button>
            </div>
            <div class="d-flex align-items-center gap-3 flex-wrap">
                <div class="calendar-legend d-flex gap-3 small text-muted">
                    <span class="d-flex align-items-center gap-1">
                        <span class="legend-dot" style="background:linear-gradient(135deg,#2f946f,#1f7a5a)"></span> Đang thuê
                    </span>
                    <span class="d-flex align-items-center gap-1">
                        <span class="legend-dot" style="background:linear-gradient(135deg,#667085,#475467)"></span> Đã kết thúc
                    </span>
                    <span class="d-flex align-items-center gap-1">
                        <span class="legend-line"></span> Hôm nay
                    </span>
                </div>
                <select id="roomFilter" class="form-select form-select-sm" style="width:185px" onchange="applyFilter()">
                    <option value="0">Tất cả phòng</option>
                </select>
            </div>
        </div>
    </div>

    <div class="cal-shell">
        <div class="cal-wrap">
            <div id="calendarGrid" class="cal-grid"></div>
        </div>
    </div>
</div>

<!-- DevExtreme Popup container -->
@Html.AntiForgeryToken()
<div id="contractDetailPopup"></div>

@section Scripts {
<script>
    const MONTHS = ['Tháng 1','Tháng 2','Tháng 3','Tháng 4','Tháng 5','Tháng 6',
                    'Tháng 7','Tháng 8','Tháng 9','Tháng 10','Tháng 11','Tháng 12'];
    const DAYS_VI = ['CN','T2','T3','T4','T5','T6','T7'];
    const _token = document.querySelector('input[name="__RequestVerificationToken"]').value;

    let cur = { year: new Date().getFullYear(), month: new Date().getMonth() + 1 };
    let allRooms = [], allContracts = [], curDays = 30;

    function parseDate(s) {
        var p = s.split('-'); return new Date(+p[0], +p[1]-1, +p[2]);
    }
    function isToday(y, m, d) {
        var t = new Date(); return t.getFullYear()===y && t.getMonth()+1===m && t.getDate()===d;
    }

    async function loadData() {
        document.getElementById('calendarGrid').innerHTML =
            '<div class="text-center py-5 text-muted"><i class="fas fa-spinner fa-spin fa-2x d-block mb-2"></i>Đang tải...</div>';
        var res  = await fetch('/Contract/GetCalendarData?year='+cur.year+'&month='+cur.month);
        var data = await res.json();
        allRooms     = data.rooms;
        allContracts = data.contracts;
        curDays      = data.daysInMonth;
        populateFilter();
        updateStats();
        renderCalendar();
    }

    function populateFilter() {
        var sel = document.getElementById('roomFilter');
        var val = sel.value;
        sel.innerHTML = '<option value="0">Tất cả phòng</option>';
        allRooms.forEach(function(r) {
            var o = document.createElement('option');
            o.value = r.id; o.textContent = r.name;
            sel.appendChild(o);
        });
        sel.value = val;
    }

    function applyFilter() { renderCalendar(); }

    function updateStats() {
        var active = allContracts.filter(function(c){ return c.isActive; });
        var occ    = new Set(active.map(function(c){ return c.roomId; }));
        var rev    = active.reduce(function(s,c){ return s + c.monthlyRent; }, 0);
        document.getElementById('statTotal').textContent     = allRooms.length;
        document.getElementById('statOccupied').textContent  = occ.size;
        document.getElementById('statAvailable').textContent = allRooms.length - occ.size;
        document.getElementById('statRevenue').textContent   = rev.toLocaleString('vi-VN') + ' VNĐ';
    }

    function renderCalendar() {
        var selRoom = parseInt(document.getElementById('roomFilter').value) || 0;
        var rooms   = selRoom ? allRooms.filter(function(r){ return r.id === selRoom; }) : allRooms;
        var n       = curDays;
        var todayD  = (cur.year === new Date().getFullYear() && cur.month === new Date().getMonth()+1)
                        ? new Date().getDate() : -1;
        var html = '';

        /* ── Header row ── */
        html += '<div class="cal-hdr-row" style="position:sticky;top:0;z-index:20;">';
        html += '<div class="cal-room-col">Phòng</div>';
        html += '<div class="cal-days-area">';
        for (var d = 1; d <= n; d++) {
            var dow    = new Date(cur.year, cur.month-1, d).getDay();
            var cls    = 'cal-day-hdr';
            if (isToday(cur.year, cur.month, d)) cls += ' today';
            if (dow===0||dow===6)                cls += ' weekend';
            html += '<div class="'+cls+'"><span class="dow">'+DAYS_VI[dow]+'</span>'+d+'</div>';
        }
        html += '</div></div>';

        if (rooms.length === 0) {
            html += '<div class="text-center py-5 text-muted">Không có phòng nào</div>';
        }

        /* ── Room rows ── */
        rooms.forEach(function(room) {
            var contracts = allContracts.filter(function(c){ return c.roomId === room.id; });
            var stCls = room.status === 0 ? 'available' : room.status === 2 ? 'pending' : 'occupied';
            var stTxt = room.status === 0 ? 'Trống' : room.status === 2 ? 'Chờ duyệt' : 'Đang thuê';

            html += '<div class="cal-room-row">';

            /* room info col */
            html += '<div class="cal-room-col">'
                  + '<div class="room-name">'+room.name+'</div>'
                  + '<div class="room-meta"><i class="fas fa-map-marker-alt me-1"></i>'+room.address+'</div>'
                  + '<div class="room-price"><i class="fas fa-money-bill me-1"></i>'+(+room.price).toLocaleString('vi-VN')+' VNĐ/tháng</div>'
                  + '<span class="room-status-pill '+stCls+'">'+stTxt+'</span>'
                  + '</div>';

            /* days area */
            html += '<div class="cal-days-area">';

            /* bg grid */
            html += '<div class="cal-bg-cells">';
            for (var d = 1; d <= n; d++) {
                var dow   = new Date(cur.year, cur.month-1, d).getDay();
                var cls   = 'cal-bg-cell';
                if (isToday(cur.year, cur.month, d)) cls += ' today';
                if (dow===0||dow===6)                cls += ' weekend';
                html += '<div class="'+cls+'"></div>';
            }
            html += '</div>';

            /* empty label */
            if (contracts.length === 0) {
                html += '<div class="cal-empty-lbl">Chưa có hợp đồng trong tháng này</div>';
            }

            /* contract bars */
            contracts.forEach(function(c) {
                var cStart = parseDate(c.startDate);
                var cEnd   = parseDate(c.endDate);
                var mStart = new Date(cur.year, cur.month-1, 1);
                var mEnd   = new Date(cur.year, cur.month-1, n);
                var bStart = cStart < mStart ? 1 : cStart.getDate();
                var bEnd   = cEnd   > mEnd   ? n : cEnd.getDate();
                var left   = (bStart - 1) / n * 100;
                var width  = (bEnd - bStart + 1) / n * 100;
                var bg     = c.isActive
                    ? 'linear-gradient(135deg,#2f946f,#1f7a5a)'
                    : 'linear-gradient(135deg,#667085,#475467)';
                var barCls = c.isActive ? 'cal-bar' : 'cal-bar ended';

                html += '<div class="'+barCls+'"'
                      + ' style="left:'+left+'%;width:'+width+'%;background:'+bg+';"'
                      + ' onclick="showDetail('+c.id+')"'
                      + ' title="'+c.userFullName+' | '+c.startDateDisplay+' - '+c.endDateDisplay+'">'
                      + '<div class="cal-bar-content">'
                      + '<span class="bar-name">'+c.userFullName+'</span>'
                      + '<span class="bar-dates">'+c.startDateDisplay+' - '+c.endDateDisplay+'</span>'
                      + '</div>'
                      + '</div>';
            });

            /* today line */
            if (todayD > 0) {
                var lp = (todayD - 0.5) / n * 100;
                html += '<div class="cal-today-line" style="left:'+lp+'%"></div>';
            }

            html += '</div></div>';
        });

        document.getElementById('calendarGrid').innerHTML = html;
    }

    /* ── Detail popup ── */

    /* ── Helpers render HTML label-value ── */
    function _iv(v, cls) {
        var empty = !v || v === '—';
        return '<span class="info-value' + (empty ? ' muted' : (cls ? ' ' + cls : '')) + '">' + (empty ? '—' : v) + '</span>';
    }
    function _ii(label, v, span, cls) {
        return '<div class="info-item' + (span ? ' span-2' : '') + '"><span class="info-label">' + label + '</span>' + _iv(v, cls) + '</div>';
    }
    function _buildDetailHtml(d) {
        var badge = d.isActive
            ? '<span class="badge bg-success px-2 py-1" style="font-size:12px">✔ Đang hiệu lực</span>'
            : '<span class="badge bg-secondary px-2 py-1" style="font-size:12px">✖ Đã kết thúc</span>';
        return [
            '<div class="info-group">',
                '<div class="info-group-title">🏠 Thông tin phòng</div>',
                '<div class="info-grid">',
                    _ii('Tên phòng',  d.roomName),   _ii('Diện tích', d.roomArea),
                    _ii('Địa chỉ',   d.roomAddress, true),
                    _ii('Loại phòng', d.roomType),   _ii('Tầng',      d.roomFloor),
                '</div>',
            '</div>',
            '<div class="info-group">',
                '<div class="info-group-title">👤 Thông tin người thuê</div>',
                '<div class="info-grid">',
                    _ii('Họ tên',              d.tenantName),  _ii('Số điện thoại', d.tenantPhone),
                    _ii('Email',               d.tenantEmail), _ii('Số CCCD',       d.tenantCccd),
                    _ii('Liên hệ khẩn cấp',   d.tenantEmergency, true),
                '</div>',
            '</div>',
            '<div class="info-group">',
                '<div class="info-group-title">📄 Thông tin hợp đồng</div>',
                '<div class="info-grid">',
                    _ii('Ngày bắt đầu',              d.startDate),    _ii('Ngày kết thúc', d.endDate),
                    _ii('Giá thuê / tháng',           d.monthlyRent, false, 'money'),
                    _ii('Tiền cọc',                  d.deposit),
                    _ii('Ngày thanh toán hàng tháng', d.paymentDay),
                    _ii('Phí quản lý',               d.managementFee), _ii('Phí gửi xe', d.parkingFee),
                    _ii('Chỉ số điện đầu kỳ',         d.electricMeter), _ii('Chỉ số nước đầu kỳ', d.waterMeter),
                    '<div class="info-item"><span class="info-label">Trạng thái</span>' + badge + '</div>',
                '</div>',
            '</div>'
        ].join('');
    }

    var _detailPopup    = null;
    var _detailContent  = null;  /* jQuery ref tới scroll container bên trong popup */
    var _currentLink    = '#';
    var _currentContractId = null;

    function showDetail(contractId) {
        var c    = allContracts.find(function(x){ return x.id === contractId; });
        if (!c) return;
        var room = allRooms.find(function(r){ return r.id === c.roomId; });

        var d = {
            roomName:        room ? room.name           : 'N/A',
            roomArea:        room ? room.area + ' m²'   : '—',
            roomAddress:     room ? room.address        : '—',
            roomType:        '—',
            roomFloor:       '—',
            tenantName:      c.userFullName || '—',
            tenantPhone:     '—',
            tenantEmail:     c.userEmail   || '—',
            tenantCccd:      '—',
            tenantEmergency: '—',
            startDate:       c.startDateDisplay        || '—',
            endDate:         c.endDateDisplay          || '—',
            monthlyRent:     c.monthlyRentFormatted    || '—',
            deposit:         c.deposit      != null ? Number(c.deposit).toLocaleString('vi-VN') + ' VNĐ' : '—',
            paymentDay:      c.paymentDay   != null ? 'Ngày ' + c.paymentDay + ' hàng tháng' : '—',
            managementFee:   c.managementFee!= null ? Number(c.managementFee).toLocaleString('vi-VN') + ' VNĐ' : '—',
            parkingFee:      c.parkingFee   != null ? Number(c.parkingFee).toLocaleString('vi-VN') + ' VNĐ' : '—',
            electricMeter:   c.electricMeter!= null ? c.electricMeter + ' kWh' : '—',
            waterMeter:      c.waterMeter   != null ? c.waterMeter + ' m³' : '—',
            isActive:        c.isActive
        };
        _currentLink = '/Contract/Details/' + c.id;
        _currentContractId = c.id;

        if (!_detailPopup) {
            _detailPopup = $('#contractDetailPopup').dxPopup({
                title: 'Chi tiết hợp đồng',
                width: 820,
                height: 'auto',
                maxHeight: '92vh',
                dragEnabled: true,
                hideOnOutsideClick: false,
                showCloseButton: true,
                toolbarItems: [
                    {
                        widget: 'dxButton', toolbar: 'bottom', location: 'before',
                        options: {
                            text: 'In hợp đồng', type: 'default', icon: 'print',
                            onClick: function () { window.open(_currentLink, '_blank'); }
                        }
                    },
                    {
                        widget: 'dxButton', toolbar: 'bottom', location: 'after',
                        options: {
                            text: 'Gia hạn', type: 'normal', icon: 'refresh',
                            onClick: function () {
                                openCalendarRenew();
                            }
                        }
                    },
                    {
                        widget: 'dxButton', toolbar: 'bottom', location: 'after',
                        options: {
                            text: 'Đóng', type: 'danger', icon: 'close',
                            onClick: function () { _detailPopup.hide(); }
                        }
                    }
                ],
                contentTemplate: function (container) {
                    _detailContent = $('<div>').css({
                        overflowY: 'auto',
                        maxHeight: 'calc(92vh - 130px)',
                        padding: '14px 18px'
                    }).appendTo(container);
                    _detailContent.html(_buildDetailHtml(d));
                }
            }).dxPopup('instance');
        } else {
            _detailContent.html(_buildDetailHtml(d));
        }

        _detailPopup.show();
    }

    function fmtIsoDate(d) {
        return d.getFullYear() + '-' +
            String(d.getMonth() + 1).padStart(2, '0') + '-' +
            String(d.getDate()).padStart(2, '0');
    }

    async function openCalendarRenew() {
        var c = allContracts.find(function(x){ return x.id === _currentContractId; });
        if (!c) return;
        if (!c.isActive) {
            Swal.fire({ icon: 'warning', title: 'Không thể gia hạn', text: 'Chỉ có thể gia hạn hợp đồng đang hiệu lực.' });
            return;
        }

        var currentEnd = parseDate(c.endDate);
        var suggestedEnd = new Date(currentEnd);
        suggestedEnd.setMonth(suggestedEnd.getMonth() + 6);
        var minEnd = new Date(currentEnd.getFullYear(), currentEnd.getMonth(), currentEnd.getDate() + 1);

        var result = await Swal.fire({
            title: 'Gia hạn hợp đồng',
            html:
                '<div class="text-start">' +
                '<div class="small text-muted mb-2">Người thuê: <strong>' + (c.userFullName || '—') + '</strong></div>' +
                '<label class="form-label fw-semibold">Ngày kết thúc hiện tại</label>' +
                '<input class="form-control mb-3" value="' + c.endDateDisplay + '" disabled>' +
                '<label class="form-label fw-semibold">Ngày kết thúc mới</label>' +
                '<input id="calRenewEndDate" type="date" class="form-control mb-3" value="' + fmtIsoDate(suggestedEnd) + '" min="' + fmtIsoDate(minEnd) + '">' +
                '<label class="form-label fw-semibold">Giá thuê mới (VNĐ/tháng)</label>' +
                '<input id="calRenewRent" type="number" min="1" step="100000" class="form-control mb-3" value="' + Math.round(c.monthlyRent || 0) + '">' +
                '<label class="form-label fw-semibold">Ghi chú</label>' +
                '<textarea id="calRenewNote" class="form-control" rows="3" placeholder="VD: Gia hạn thêm 6 tháng, giữ nguyên điều khoản..."></textarea>' +
                '</div>',
            imageUrl: window._swalConfirmImg,
            imageWidth: 80,
            imageHeight: 80,
            showCancelButton: true,
            confirmButtonText: 'Gia hạn',
            cancelButtonText: 'Hủy',
            confirmButtonColor: '#1f7a5a',
            preConfirm: function() {
                var endDate = document.getElementById('calRenewEndDate').value;
                var rent = document.getElementById('calRenewRent').value;
                if (!endDate) {
                    Swal.showValidationMessage('Vui lòng chọn ngày kết thúc mới');
                    return false;
                }
                if (new Date(endDate) <= currentEnd) {
                    Swal.showValidationMessage('Ngày kết thúc mới phải sau ngày kết thúc hiện tại');
                    return false;
                }
                if (rent && Number(rent) <= 0) {
                    Swal.showValidationMessage('Giá thuê mới phải lớn hơn 0');
                    return false;
                }
                return {
                    endDate: endDate,
                    rent: rent,
                    note: document.getElementById('calRenewNote').value || ''
                };
            }
        });

        if (!result.isConfirmed) return;

        var body = new URLSearchParams({
            __RequestVerificationToken: _token,
            ContractId: c.id,
            NewEndDate: result.value.endDate,
            Note: result.value.note
        });
        if (result.value.rent) body.append('MonthlyRent', result.value.rent);

        var res = await fetch('/Contract/Renew', { method: 'POST', body: body });
        var json = await res.json();
        if (json.success) {
            if (_detailPopup) _detailPopup.hide();
            await loadData();
            Swal.fire({ icon: 'success', title: 'Thành công', text: json.message, timer: 2200, showConfirmButton: false });
        } else {
            Swal.fire({ icon: 'error', title: 'Không thể gia hạn', html: json.message });
        }
    }

    /* ── Navigation ── */
    function prevMonth() {
        cur.month--; if (cur.month < 1)  { cur.month = 12; cur.year--; }
        document.getElementById('monthLabel').textContent = MONTHS[cur.month-1] + ' ' + cur.year;
        loadData();
    }
    function nextMonth() {
        cur.month++; if (cur.month > 12) { cur.month = 1;  cur.year++; }
        document.getElementById('monthLabel').textContent = MONTHS[cur.month-1] + ' ' + cur.year;
        loadData();
    }
    function goToday() {
        var t = new Date(); cur.year = t.getFullYear(); cur.month = t.getMonth()+1;
        document.getElementById('monthLabel').textContent = MONTHS[cur.month-1] + ' ' + cur.year;
        loadData();
    }

    /* ── Init ── */
    $(function() {
        document.getElementById('monthLabel').textContent = MONTHS[cur.month-1] + ' ' + cur.year;
        loadData();
    });
</script>
}
