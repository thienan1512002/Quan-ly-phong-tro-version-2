@model QuanLyPhongTro.Models.ViewModels.ContractCreateViewModel
@{
    ViewData["Title"] = "Tạo hợp đồng mới";
}

<div class="d-flex align-items-center mb-3">
    <a asp-action="Index" class="btn btn-outline-secondary me-2">
        <i class="fas fa-arrow-left"></i>
    </a>
    <h4 class="mb-0"><i class="fas fa-file-contract me-2 text-success"></i>Tạo hợp đồng mới</h4>
</div>

<div class="card" style="max-width:600px;">
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <!-- Chọn phòng -->
            <div class="mb-3">
                <label asp-for="RoomId" class="form-label fw-semibold">
                    <i class="fas fa-door-open me-1"></i> Chọn phòng (chỉ phòng trống)
                </label>
                <select asp-for="RoomId" asp-items="ViewBag.Rooms" class="form-select">
                    <option value="">-- Chọn phòng --</option>
                </select>
                <span asp-validation-for="RoomId" class="text-danger small"></span>
            </div>

            <!-- Chọn người thuê -->
            <div class="mb-3">
                <label asp-for="UserId" class="form-label fw-semibold">
                    <i class="fas fa-user me-1"></i> Chọn người thuê
                </label>
                <select asp-for="UserId" asp-items="ViewBag.Users" class="form-select">
                    <option value="">-- Chọn người thuê --</option>
                </select>
                <span asp-validation-for="UserId" class="text-danger small"></span>
            </div>

            <!-- Ngày bắt đầu -->
            <div class="mb-3">
                <label asp-for="StartDate" class="form-label fw-semibold">
                    <i class="fas fa-calendar-alt me-1"></i> Ngày bắt đầu
                </label>
                <input asp-for="StartDate" class="form-control" type="date" />
                <span asp-validation-for="StartDate" class="text-danger small"></span>
            </div>

            <!-- Ngày kết thúc -->
            <div class="mb-3">
                <label asp-for="EndDate" class="form-label fw-semibold">
                    <i class="fas fa-calendar-check me-1"></i> Ngày kết thúc
                </label>
                <input asp-for="EndDate" class="form-control" type="date" />
                <span asp-validation-for="EndDate" class="text-danger small"></span>
            </div>

            <!-- Ghi chú -->
            <div class="mb-3">
                <label asp-for="Note" class="form-label fw-semibold">Ghi chú</label>
                <textarea asp-for="Note" class="form-control" rows="2"
                          placeholder="VD: Hợp đồng 6 tháng, có thể gia hạn..."></textarea>
            </div>

            <!-- Lưu ý -->
            <div class="alert alert-info small">
                <i class="fas fa-info-circle me-2"></i>
                Sau khi tạo hợp đồng, phòng sẽ tự động chuyển sang trạng thái <strong>Đã thuê</strong>.
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-success">
                    <i class="fas fa-file-signature me-1"></i> Tạo hợp đồng
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
            </div>
        </form>
    </div>
</div>
