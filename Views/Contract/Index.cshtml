@model List<QuanLyPhongTro.Models.Contract>
@{
    ViewData["Title"] = "Quản lý hợp đồng";
}

<div class="contract-page">
<!-- Header -->
<div class="contract-titlebar">
    <div class="contract-title">
        <span class="title-icon"><i class="fas fa-file-contract"></i></span>
        <div>
            <h4>Hợp đồng thuê phòng</h4>
            <div class="page-subtitle">Quản lý hợp đồng, thời hạn thuê, doanh thu và thao tác gia hạn/kết thúc.</div>
        </div>
    </div>
    <a asp-action="Create" class="btn btn-success">
        <i class="fas fa-plus me-1"></i> Tạo hợp đồng mới
    </a>
</div>

<!-- Stat cards -->
<div class="row g-3 mb-3">
    <div class="col-6 col-xl-3">
        <div class="card h-100 contract-stat-card stat-filter-card" id="cardTotal" role="button" title="Xem tất cả hợp đồng">
            <div class="card-body">
                <span class="contract-stat-icon text-primary"><i class="fas fa-file-contract"></i></span>
                <div>
                    <div class="contract-stat-label">Tổng hợp đồng</div>
                    <div class="contract-stat-value text-primary" id="statTotal">—</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card h-100 contract-stat-card stat-filter-card" id="cardActive" role="button" title="Lọc hợp đồng đang hiệu lực">
            <div class="card-body">
                <span class="contract-stat-icon text-success"><i class="fas fa-check-circle"></i></span>
                <div>
                    <div class="contract-stat-label">Đang hiệu lực</div>
                    <div class="contract-stat-value text-success" id="statActive">—</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card h-100 contract-stat-card stat-filter-card" id="cardEnded" role="button" title="Lọc hợp đồng đã kết thúc">
            <div class="card-body">
                <span class="contract-stat-icon text-secondary"><i class="fas fa-stop-circle"></i></span>
                <div>
                    <div class="contract-stat-label">Đã kết thúc</div>
                    <div class="contract-stat-value text-secondary" id="statEnded">—</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card h-100 contract-stat-card">
            <div class="card-body">
                <span class="contract-stat-icon text-warning"><i class="fas fa-money-bill-wave"></i></span>
                <div>
                    <div class="contract-stat-label">Doanh thu/tháng</div>
                    <div class="contract-stat-value text-warning" id="statRevenue" style="font-size:1.05rem">—</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="contract-filterbar">
    <div class="filter-room">
        <span class="filter-label"><i class="fas fa-door-open me-1"></i>Lọc phòng</span>
        <div id="roomFilterBox" class="room-filter-box"></div>
        <button id="btnClearRoomFilter" class="btn btn-sm btn-outline-secondary" style="display:none" onclick="clearRoomFilter()">
            <i class="fas fa-times me-1"></i>Xóa
        </button>
    </div>
    <div id="activeFilterBar" style="display:none" class="active-filter-chip">
        <span class="text-muted small"><i class="fas fa-filter me-1"></i>Đang lọc</span>
        <span id="activeFilterLabel" class="badge rounded-pill"></span>
        <button id="btnClearFilter" class="btn btn-sm btn-outline-secondary" onclick="clearStatFilter()">
            <i class="fas fa-times me-1"></i>Bỏ lọc
        </button>
    </div>
</div>

<!-- DataGrid -->
<div class="contract-grid-shell">
    <div id="contractGrid"></div>
</div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
<style>
    .contract-page {
        max-width: 1480px;
        margin: 0 auto;
    }

    .contract-titlebar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 22px;
    }

    .contract-title {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .contract-title h4 {
        margin: 0;
        color: #172033;
        font-weight: 750;
    }

    .contract-title .title-icon {
        width: 38px;
        height: 38px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        background: #ecfdf3;
        color: #079455;
    }

    .contract-stat-card .card-body {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 16px 18px;
    }

    .contract-stat-icon {
        width: 42px;
        height: 42px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        background: #f2f4f7;
        flex-shrink: 0;
    }

    .contract-stat-label {
        color: #667085;
        font-size: .82rem;
        font-weight: 600;
    }

    .contract-stat-value {
        margin-top: 5px;
        font-size: 1.45rem;
        line-height: 1;
        font-weight: 800;
    }

    .contract-filterbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
        margin: 4px 0 14px;
        padding: 12px 14px;
        border: 1px solid #e5e9f2;
        border-radius: 8px;
        background: rgba(255,255,255,.78);
        box-shadow: 0 4px 14px rgba(17, 24, 39, .04);
    }

    .filter-room,
    .active-filter-chip {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }

    .filter-label {
        color: #667085;
        font-size: .84rem;
        font-weight: 700;
    }

    .room-filter-box {
        width: 290px;
        min-width: 220px;
    }

    .active-filter-chip .badge {
        font-size: 12px;
        padding: 6px 11px;
    }

    .contract-grid-shell {
        overflow: hidden;
        border: 1px solid #e5e9f2;
        border-radius: 8px;
        background: #fff;
        box-shadow: 0 14px 34px rgba(17, 24, 39, .08);
    }

    .contract-grid-shell .dx-datagrid {
        background: #fff;
    }

    .contract-grid-shell .dx-datagrid-headers {
        border-bottom: 1px solid #e5e9f2;
    }

    .contract-grid-shell .dx-header-row > td {
        padding-top: 12px;
        padding-bottom: 12px;
        color: #344054;
        font-weight: 800;
    }

    .contract-grid-shell .dx-data-row > td {
        padding-top: 12px;
        padding-bottom: 12px;
        vertical-align: middle;
    }

    .contract-grid-shell .dx-row-alt > td {
        background: #fbfcff !important;
    }

    .contract-grid-shell .dx-datagrid-search-panel {
        border-radius: 8px;
    }

    .detail-panel { padding: 16px 20px; background: #f8fafc; }
    .detail-card  { background: #fff; border-radius: 10px; border: 1px solid #e5e7eb; padding: 16px; }
    .detail-card .dc-title { font-weight: 700; font-size: 13px; margin-bottom: 10px; display: flex; align-items: center; gap: 7px; }
    .detail-row   { display: flex; flex-wrap: wrap; gap: 6px 20px; }
    .detail-item  { font-size: 12px; color: #374151; min-width: 180px; }
    .detail-item .lbl { color: #9ca3af; display: block; font-size: 11px; }
    .stat-filter-card { cursor: pointer; transition: transform .16s ease, box-shadow .16s ease, border-color .16s ease; }
    .stat-filter-card:hover { transform: translateY(-1px); box-shadow: 0 12px 28px rgba(17,24,39,.1) !important; }
    .stat-filter-card.active-card { border-color: currentColor !important; box-shadow: 0 0 0 3px rgba(37,86,217,.12) !important; }
    #cardTotal.active-card  { color: #1f7a5a; }
    #cardActive.active-card { color: #079455; }
    #cardEnded.active-card  { color: #667085; }
    .stat-updating { opacity: .6; transition: opacity .15s; }
    /* ── Info-group layout (master-detail) ── */
    .ig-wrap            { padding: 18px 20px; }
    .ig-row             { display:flex; gap:16px; flex-wrap:wrap; }
    .ig-col             { flex:1; min-width:220px; }
    .ig-box             { background:#f8fafc; border:1px solid #e5e7eb; border-radius:10px; padding:14px 18px; height:100%; }
    .ig-title           { font-weight:700; font-size:13px; color:#374151; margin-bottom:12px; display:flex; align-items:center; gap:7px; border-bottom:1px solid #e5e7eb; padding-bottom:8px; }
    .ig-grid            { display:grid; grid-template-columns:1fr 1fr; gap:7px 18px; }
    .ig-item            { display:flex; flex-direction:column; gap:2px; }
    .ig-item.full       { grid-column:span 2; }
    .ig-lbl             { font-size:11px; color:#9ca3af; font-weight:500; text-transform:uppercase; letter-spacing:.4px; }
    .ig-val             { font-size:13px; color:#1e293b; font-weight:500; }
    .ig-val.muted       { color:#9ca3af; font-style:italic; }
    .ig-val.money       { color:#16a34a; font-weight:700; }
    .ig-val.danger      { color:#dc3545; font-weight:600; }
    .ig-val.success     { color:#198754; font-weight:600; }

    @@media (max-width: 767.98px) {
        .contract-titlebar {
            align-items: stretch;
            flex-direction: column;
        }

        .contract-titlebar .btn {
            width: 100%;
        }

        .room-filter-box {
            width: 100%;
        }
    }
</style>
<script>
    const _token = document.querySelector('input[name="__RequestVerificationToken"]').value;

    function setActiveCard(id, label, badgeClass) {
        document.querySelectorAll('.stat-filter-card').forEach(c => c.classList.remove('active-card'));
        var bar   = document.getElementById('activeFilterBar');
        var lbl   = document.getElementById('activeFilterLabel');
        if (id) {
            document.getElementById(id).classList.add('active-card');
            lbl.textContent = label;
            lbl.className   = 'badge rounded-pill ' + badgeClass;
            bar.style.display = '';
        } else {
            lbl.textContent   = '';
            bar.style.display = 'none';
        }
    }

    function clearStatFilter() {
        setActiveCard(null);
        // Giữ lại room filter nếu đang chọn
        const roomVal = $("#roomFilterBox").dxSelectBox("instance").option("value");
        if (roomVal) {
            $("#contractGrid").dxDataGrid("instance").filter(["roomName", "=", roomVal]);
        } else {
            $("#contractGrid").dxDataGrid("instance").clearFilter();
        }
    }

    function clearRoomFilter() {
        $("#roomFilterBox").dxSelectBox("instance").option("value", null);
        $("#btnClearRoomFilter").hide();
        const grid = $("#contractGrid").dxDataGrid("instance");
        grid.clearFilter();
    }

    // Tính thời hạn theo calendar months + ngày dư (từ chuỗi dd/MM/yyyy)
    function calcDur(startStr, endStr, fallbackDays) {
        try {
            const p = s => { const [d,m,y] = s.split('/'); return new Date(+y, +m-1, +d); };
            const s = p(startStr), e = p(endStr);
            let months = (e.getFullYear() - s.getFullYear()) * 12 + (e.getMonth() - s.getMonth());
            // Điều chỉnh nếu ngày cuối < ngày đầu trong tháng
            const adj = new Date(s.getFullYear(), s.getMonth() + months, s.getDate());
            let remDays = Math.round((e - adj) / 86400000);
            if (remDays < 0) { months--; remDays += new Date(e.getFullYear(), e.getMonth() + 1, 0).getDate(); }
            if (months > 0) return months + ' tháng' + (remDays > 0 ? ' ' + remDays + ' ngày' : '');
            return (fallbackDays || remDays) + ' ngày';
        } catch { return fallbackDays + ' ngày'; }
    }

    $(function () {
        // ── Room filter dropdown ──────────────────────────────────
        $.getJSON('/Room/GetAll').then(function (rooms) {
            const roomNames = [...new Set(rooms.map(r => r.name).filter(Boolean))].sort();
            $("#roomFilterBox").dxSelectBox({
                items: roomNames,
                placeholder: "Tất cả phòng...",
                showClearButton: true,
                searchEnabled: true,
                onValueChanged: function (e) {
                    const grid = $("#contractGrid").dxDataGrid("instance");
                    setActiveCard(null); // bỏ stat filter khi chọn room
                    if (e.value) {
                        $("#btnClearRoomFilter").show();
                        grid.filter(["roomName", "=", e.value]);
                    } else {
                        $("#btnClearRoomFilter").hide();
                        grid.clearFilter();
                    }
                }
            });
        });

        const store = new DevExpress.data.CustomStore({
            key: 'id',
            load(loadOptions) {
                const params = {
                    skip: loadOptions.skip  ?? 0,
                    take: loadOptions.take  ?? 10,
                    requireTotalCount: true
                };
                if (loadOptions.filter) params.filter = JSON.stringify(loadOptions.filter);
                if (loadOptions.sort)   params.sort   = JSON.stringify(loadOptions.sort);

                return $.getJSON('/Contract/GetAll', params).then(function (result) {
                    document.getElementById('statTotal').textContent   = result.summary[0];
                    document.getElementById('statActive').textContent  = result.summary[1];
                    document.getElementById('statEnded').textContent   = result.summary[0] - result.summary[1];
                    document.getElementById('statRevenue').textContent =
                        parseFloat(result.summary[2]).toLocaleString('vi-VN') + ' VNĐ';
                    return { data: result.data, totalCount: result.totalCount };
                });
            }
        });

        $("#contractGrid").dxDataGrid({
            dataSource: store,
            remoteOperations: { filtering: true, sorting: true, paging: true },
            columns: [
                    {
                        caption: "STT", width: 55, alignment: "center", allowSorting: false,
                        cellTemplate(container, opt) {
                            $(container).text(opt.component.pageIndex() * opt.component.pageSize() + opt.rowIndex + 1);
                        }
                    },
                    {
                        dataField: "roomName", caption: "Phòng", minWidth: 160,
                        cellTemplate(container, opt) {
                            $('<div class="fw-semibold">').text(opt.value).appendTo(container);
                            $('<div class="text-muted" style="font-size:11px">').html('<i class="fas fa-map-marker-alt me-1"></i>' + opt.data.roomAddress).appendTo(container);
                        }
                    },
                    {
                        dataField: "userName", caption: "Người thuê", minWidth: 140,
                        cellTemplate(container, opt) {
                            $('<div class="fw-semibold">').text(opt.value).appendTo(container);
                        }
                    },
                    {
                        caption: "Liên hệ", minWidth: 185,
                        cellTemplate(container, opt) {
                            $('<div style="font-size:12px">').html('<i class="fas fa-envelope me-1 text-muted"></i>' + opt.data.userEmail).appendTo(container);
                            if (opt.data.userPhone) {
                                $('<div style="font-size:12px">').html('<i class="fas fa-phone me-1 text-muted"></i>' + opt.data.userPhone).appendTo(container);
                            } else {
                                $('<div style="font-size:11px;color:#d1d5db">').html('<i class="fas fa-phone me-1"></i>Chưa cập nhật SĐT').appendTo(container);
                            }
                        }
                    },
                    {
                        caption: "Thời gian thuê", width: 210,
                        cellTemplate(container, opt) {
                            const dur    = calcDur(opt.data.startDate, opt.data.endDate, opt.data.durationDays);
                            $('<div>').html(
                                '<span class="me-2"><i class="fas fa-play-circle text-success me-1"></i>' + opt.data.startDate + '</span>' +
                                '<span><i class="fas fa-stop-circle text-danger me-1"></i>' + opt.data.endDate + '</span>'
                            ).appendTo(container);
                            $('<div class="text-muted" style="font-size:11px">').html('<i class="fas fa-clock me-1"></i>' + dur).appendTo(container);
                        }
                    },
                    {
                        dataField: "monthlyRent", caption: "Tiền thuê/tháng", width: 165,
                        cellTemplate(container, opt) {
                            $('<span class="text-success fw-bold">').text(opt.data.monthlyRentFormatted).appendTo(container);
                        }
                    },
                    {
                        dataField: "isActive", caption: "Trạng thái", width: 140,
                        sortIndex: 0, sortOrder: 'desc',
                        cellTemplate(container, opt) {
                            const cls  = opt.data.isActive ? 'bg-success' : 'bg-secondary';
                            const icon = opt.data.isActive ? '✅' : '⏹';
                            $('<span>').addClass('badge ' + cls).text(icon + ' ' + opt.data.statusText).appendTo(container);
                        }
                    },
                    {
                        caption: "Thao tác", width: 155, alignment: "center",
                        cellTemplate(container, opt) {
                            const wrap = $('<div style="display:flex;align-items:center;justify-content:center;gap:4px">');
                            $('<a class="btn btn-sm btn-info">')
                                .attr('href', '/Contract/Details/' + opt.data.id)
                                .attr('title', 'Chi tiết')
                                .html('<i class="fas fa-eye"></i>')
                                .appendTo(wrap);
                            if (opt.data.isActive) {
                                $('<button class="btn btn-sm btn-outline-primary">')
                                    .attr('title', 'Gia hạn')
                                    .html('<i class="fas fa-rotate-right"></i>')
                                    .on('click', () => openRenewContract(opt.data))
                                    .appendTo(wrap);
                                $('<button class="btn btn-sm btn-danger">')
                                    .attr('title', 'Kết thúc')
                                    .html('<i class="fas fa-stop"></i>')
                                    .on('click', () => {
                                        Swal.fire({
                                            title: 'Kết thúc hợp đồng?',
                                            text: 'Phòng sẽ trở về trạng thái trống.',
                                            imageUrl: window._swalConfirmImg, imageWidth: 80, imageHeight: 80,
                                            showCancelButton: true,
                                            confirmButtonColor: '#dc3545',
                                            confirmButtonText: 'Kết thúc',
                                            cancelButtonText: 'Hủy'
                                        }).then(r => { if (r.isConfirmed) terminateContract(opt.data.id); });
                                    })
                                    .appendTo(wrap);
                            }
                            wrap.appendTo(container);
                        }
                    }
                ],
                /* ── Master-detail expand ── */
                masterDetail: {
                    enabled: true,
                    template(container, opt) {
                        const d = opt.data;
                        const dur     = calcDur(d.startDate, d.endDate, d.durationDays);
                        const roomStBadge = d.roomStatus === 'Trống'
                            ? '<span class="badge bg-success"              style="font-size:11px">✔ Trống</span>'
                            : d.roomStatus === 'Đang chờ duyệt'
                            ? '<span class="badge bg-warning text-dark"    style="font-size:11px">⏳ Đang chờ duyệt</span>'
                            : '<span class="badge bg-danger"               style="font-size:11px">● Đang thuê</span>';
                        const contractStBadge = d.isActive
                            ? '<span class="badge bg-success" style="font-size:11px">✔ Đang hiệu lực</span>'
                            : '<span class="badge bg-secondary" style="font-size:11px">✖ Đã kết thúc</span>';
                        const ii = (lbl, v, full) =>
                            `<div class="ig-item${full?' full':''}"><span class="ig-lbl">${lbl}</span><span class="ig-val${!v?' muted':''}">${v||'—'}</span></div>`;
                        $('<div class="ig-wrap">').html(`
                            <div class="ig-row">
                                <div class="ig-col">
                                    <div class="ig-box">
                                        <div class="ig-title">🏠 Thông tin phòng</div>
                                        <div class="ig-grid">
                                            ${ii('Tên phòng',    d.roomName)}
                                            ${ii('Diện tích',    d.roomArea ? d.roomArea + ' m²' : null)}
                                            ${ii('Địa chỉ',      d.roomAddress, true)}
                                            ${ii('Giá niêm yết', d.roomPriceFormatted)}
                                            <div class="ig-item"><span class="ig-lbl">Trạng thái phòng</span>${roomStBadge}</div>
                                            ${d.roomDesc ? ii('Mô tả', d.roomDesc, true) : ''}
                                        </div>
                                    </div>
                                </div>
                                <div class="ig-col">
                                    <div class="ig-box">
                                        <div class="ig-title">👤 Thông tin người thuê</div>
                                        <div class="ig-grid">
                                            ${ii('Họ tên',         d.userName)}
                                            ${ii('Tài khoản',      d.userUsername)}
                                            ${ii('Email',          d.userEmail, true)}
                                            ${ii('Số điện thoại',  d.userPhone)}
                                        </div>
                                    </div>
                                </div>
                                <div class="ig-col">
                                    <div class="ig-box">
                                        <div class="ig-title">📄 Thông tin hợp đồng</div>
                                        <div class="ig-grid">
                                            ${ii('Ngày bắt đầu',   d.startDate)}
                                            ${ii('Ngày kết thúc',  d.endDate)}
                                            ${ii('Thời hạn',       dur, false)}
                                            <div class="ig-item"><span class="ig-lbl">Giá thuê / tháng</span><span class="ig-val money">${d.monthlyRentFormatted||'—'}</span></div>
                                            ${ii('Ngày tạo',       d.createdAt)}
                                            <div class="ig-item"><span class="ig-lbl">Trạng thái HĐ</span>${contractStBadge}</div>
                                            ${d.note ? ii('Ghi chú', d.note, true) : ''}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        `).appendTo(container);
                    }
                },
                height: "auto",
                paging:  { pageSize: 30 },
                pager:   { showPageSizeSelector: true, allowedPageSizes: [10, 20, 30, 50], showInfo: true, infoText: "Trang {0}/{1} ({2} bản ghi)" },
                searchPanel: { visible: true, placeholder: "Tìm kiếm hợp đồng..." },
                headerFilter: { visible: true },
                filterRow:    { visible: true },
                showBorders:  true,
                rowAlternationEnabled: true,
                noDataText: "Chưa có hợp đồng nào"
            });

            // ── Stat card click → filter grid ──────────────────────
            document.getElementById('cardTotal').addEventListener('click', function () {
                clearStatFilter();
            });

            document.getElementById('cardActive').addEventListener('click', function () {
                setActiveCard('cardActive', '✅ Đang hiệu lực', 'bg-success');
                $("#contractGrid").dxDataGrid("instance").filter(['isActive', '=', true]);
            });

            document.getElementById('cardEnded').addEventListener('click', function () {
                setActiveCard('cardEnded', '⏹ Đã kết thúc', 'bg-secondary');
                $("#contractGrid").dxDataGrid("instance").filter(['isActive', '=', false]);
            });
        });
   
    function parseViDate(s) {
        if (!s) return null;
        const parts = s.split('/');
        if (parts.length !== 3) return null;
        return new Date(+parts[2], +parts[1] - 1, +parts[0]);
    }

    function fmtIsoDate(d) {
        return d.getFullYear() + '-' +
            String(d.getMonth() + 1).padStart(2, '0') + '-' +
            String(d.getDate()).padStart(2, '0');
    }

    async function openRenewContract(row) {
        const currentEnd = parseViDate(row.endDate) || new Date();
        const suggestedEnd = new Date(currentEnd);
        suggestedEnd.setMonth(suggestedEnd.getMonth() + 6);

        const result = await Swal.fire({
            title: 'Gia hạn hợp đồng',
            html:
                '<div class="text-start">' +
                '<div class="small text-muted mb-2">Phòng: <strong>' + row.roomName + '</strong></div>' +
                '<label class="form-label fw-semibold">Ngày kết thúc hiện tại</label>' +
                '<input class="form-control mb-3" value="' + row.endDate + '" disabled>' +
                '<label class="form-label fw-semibold">Ngày kết thúc mới</label>' +
                '<input id="renewEndDate" type="date" class="form-control mb-3" value="' + fmtIsoDate(suggestedEnd) + '" min="' + fmtIsoDate(new Date(currentEnd.getFullYear(), currentEnd.getMonth(), currentEnd.getDate() + 1)) + '">' +
                '<label class="form-label fw-semibold">Giá thuê mới (VNĐ/tháng)</label>' +
                '<input id="renewRent" type="number" min="1" step="100000" class="form-control mb-3" value="' + Math.round(row.monthlyRent || 0) + '">' +
                '<label class="form-label fw-semibold">Ghi chú</label>' +
                '<textarea id="renewNote" class="form-control" rows="3" placeholder="VD: Gia hạn thêm 6 tháng, giữ nguyên điều khoản..."></textarea>' +
                '</div>',
            imageUrl: window._swalConfirmImg,
            imageWidth: 80,
            imageHeight: 80,
            showCancelButton: true,
            confirmButtonText: 'Gia hạn',
            cancelButtonText: 'Hủy',
            confirmButtonColor: '#1f7a5a',
            preConfirm: () => {
                const endDate = document.getElementById('renewEndDate').value;
                const rent = document.getElementById('renewRent').value;
                if (!endDate) {
                    Swal.showValidationMessage('Vui lòng chọn ngày kết thúc mới');
                    return false;
                }
                if (new Date(endDate) <= currentEnd) {
                    Swal.showValidationMessage('Ngày kết thúc mới phải sau ngày kết thúc hiện tại');
                    return false;
                }
                if (rent && Number(rent) <= 0) {
                    Swal.showValidationMessage('Giá thuê mới phải lớn hơn 0');
                    return false;
                }
                return {
                    endDate,
                    rent,
                    note: document.getElementById('renewNote').value || ''
                };
            }
        });

        if (!result.isConfirmed) return;

        const body = new URLSearchParams({
            __RequestVerificationToken: _token,
            ContractId: row.id,
            NewEndDate: result.value.endDate,
            Note: result.value.note
        });
        if (result.value.rent) body.append('MonthlyRent', result.value.rent);

        const res = await fetch('/Contract/Renew', { method: 'POST', body });
        const json = await res.json();
        if (json.success) {
            $("#contractGrid").dxDataGrid("instance").getDataSource().reload();
            Swal.fire({ icon: 'success', title: 'Thành công', text: json.message, timer: 2200, showConfirmButton: false });
        } else {
            Swal.fire({ icon: 'error', title: 'Không thể gia hạn', html: json.message });
        }
    }

    async function terminateContract(id) {
        const body = new URLSearchParams({ __RequestVerificationToken: _token });
        const res  = await fetch('/Contract/Terminate/' + id, { method: 'POST', body });
        if (res.ok || res.redirected) {
            const grid = $("#contractGrid").dxDataGrid("instance");
            grid.getDataSource().reload();
            Swal.fire({ icon: 'success', title: 'Thành công', text: 'Hợp đồng đã được kết thúc. Phòng trở về trạng thái trống.', timer: 2500, showConfirmButton: false });
        } else {
            Swal.fire({ icon: 'error', title: 'Lỗi', text: 'Có lỗi xảy ra!' });
        }
    }

</script>
}

