@model List<QuanLyPhongTro.Models.Contract>
@{
    ViewData["Title"] = "Báo cáo thuê nhà";
    int selYear   = (int)ViewBag.Year;
    int selMonth  = (int)ViewBag.Month;
    bool? active  = (bool?)ViewBag.Active;
    var years     = (List<int>)ViewBag.Years;
    string[] monthNames = {"", "Tháng 1","Tháng 2","Tháng 3","Tháng 4","Tháng 5","Tháng 6",
                           "Tháng 7","Tháng 8","Tháng 9","Tháng 10","Tháng 11","Tháng 12"};
}

<style>
@@media print {
    .no-print { display: none !important; }
    .card { box-shadow: none !important; border: 1px solid #dee2e6 !important; }
    body { background: #fff !important; }
}
</style>

<!-- Header -->
<div class="d-flex justify-content-between align-items-center mb-4 no-print">
    <div>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary me-2">
            <i class="fas fa-arrow-left me-1"></i>Quay lại
        </a>
        <span class="h5 mb-0 fw-bold"><i class="fas fa-file-contract me-2 text-primary"></i>Báo cáo thuê nhà</span>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="ExportRental" asp-route-year="@selYear" asp-route-month="@selMonth"
           asp-route-active="@(active?.ToString().ToLower())"
           class="btn btn-success btn-sm">
            <i class="fas fa-file-excel me-1"></i>Xuất Excel
        </a>
        <button class="btn btn-outline-secondary btn-sm" onclick="window.print()">
            <i class="fas fa-print me-1"></i>In
        </button>
    </div>
</div>

<!-- Bộ lọc -->
<div class="card mb-4 no-print">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label fw-semibold">Năm</label>
                <select name="year" class="form-select">
                    @foreach (var y in years)
                    {
                        if (y == selYear)
                        {
                            <option value="@y" selected>@y</option>
                        }
                        else
                        {
                            <option value="@y">@y</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold">Tháng</label>
                <select name="month" class="form-select">
                    @if (selMonth == 0)
                    {
                        <option value="0" selected>Tất cả tháng</option>
                    }
                    else
                    {
                        <option value="0">Tất cả tháng</option>
                    }
                    @for (int m = 1; m <= 12; m++)
                    {
                        if (m == selMonth)
                        {
                            <option value="@m" selected>@monthNames[m]</option>
                        }
                        else
                        {
                            <option value="@m">@monthNames[m]</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold">Trạng thái</label>
                <select name="active" class="form-select">
                    @if (active == null)
                    {
                        <option value="" selected>Tất cả</option>
                    }
                    else
                    {
                        <option value="">Tất cả</option>
                    }
                    @if (active == true)
                    {
                        <option value="true" selected>Đang hiệu lực</option>
                    }
                    else
                    {
                        <option value="true">Đang hiệu lực</option>
                    }
                    @if (active == false)
                    {
                        <option value="false" selected>Đã kết thúc</option>
                    }
                    else
                    {
                        <option value="false">Đã kết thúc</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="fas fa-filter me-1"></i>Lọc
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Tiêu đề in -->
<div class="text-center mb-4 d-none d-print-block">
    <h3 class="fw-bold">BÁO CÁO THUÊ NHÀ</h3>
    <p class="text-muted mb-0">
        Kỳ: @(selMonth > 0 ? monthNames[selMonth] + "/" + selYear : "Năm " + selYear)
        @(active == true ? " — Đang hiệu lực" : active == false ? " — Đã kết thúc" : "")
    </p>
    <small>Xuất ngày: @DateTime.Today.ToString("dd/MM/yyyy")</small>
</div>

<!-- Summary cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card text-center p-3">
            <div class="text-primary mb-1"><i class="fas fa-file-contract fa-2x"></i></div>
            <h3 class="fw-bold text-primary mb-0">@ViewBag.TotalContracts</h3>
            <small class="text-muted">Tổng hợp đồng</small>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-center p-3">
            <div class="text-success mb-1"><i class="fas fa-check-circle fa-2x"></i></div>
            <h3 class="fw-bold text-success mb-0">@ViewBag.ActiveCount</h3>
            <small class="text-muted">Đang hiệu lực</small>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-center p-3">
            <div class="text-info mb-1"><i class="fas fa-money-bill-wave fa-2x"></i></div>
            <h3 class="fw-bold text-info mb-0" style="font-size:1.2rem">@(((decimal)ViewBag.TotalRent).ToString("N0"))</h3>
            <small class="text-muted">Tổng giá thuê/tháng (VNĐ)</small>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-center p-3">
            <div class="text-warning mb-1"><i class="fas fa-piggy-bank fa-2x"></i></div>
            <h3 class="fw-bold text-warning mb-0" style="font-size:1.2rem">@(((decimal)ViewBag.TotalDeposit).ToString("N0"))</h3>
            <small class="text-muted">Tổng tiền cọc (VNĐ)</small>
        </div>
    </div>
</div>

<!-- Bảng danh sách -->
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="fas fa-table me-2"></i>Danh sách hợp đồng
            — @(selMonth > 0 ? monthNames[selMonth] + "/" + selYear : "Năm " + selYear)
        </span>
        <span class="badge bg-primary">@Model.Count bản ghi</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-bordered mb-0 align-middle" style="font-size:13px">
                <thead class="table-primary">
                    <tr>
                        <th style="width:40px" class="text-center">STT</th>
                        <th>Tên phòng</th>
                        <th>Địa chỉ</th>
                        <th>Người thuê</th>
                        <th>SĐT</th>
                        <th class="text-center">Ngày BĐ</th>
                        <th class="text-center">Ngày KT</th>
                        <th class="text-end">Giá thuê/tháng</th>
                        <th class="text-end">Tiền cọc</th>
                        <th class="text-center">Trạng thái</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="10" class="text-center text-muted py-4">
                                <i class="fas fa-inbox fa-2x d-block mb-2"></i>Không có hợp đồng nào phù hợp
                            </td>
                        </tr>
                    }
                    @{int stt = 1;}
                    @foreach (var c in Model)
                    {
                        var today     = DateTime.Today;
                        var daysLeft  = (c.EndDate - today).Days;
                        var isExpiringSoon = c.IsActive
                            && c.EndDate >= today
                            && c.EndDate <= today.AddMonths(1);
                        var rowCls    = !c.IsActive ? "table-secondary" : isExpiringSoon ? "table-danger" : "";
                        var statusBadge = c.IsActive ? "<span class='badge bg-success'>Hiệu lực</span>"
                                                     : "<span class='badge bg-secondary'>Kết thúc</span>";
                        <tr class="@rowCls">
                            <td class="text-center text-muted">@(stt++)</td>
                            <td class="fw-semibold">@(c.Room?.Name ?? "—")</td>
                            <td class="text-muted small">@(c.Room?.Address ?? "—")</td>
                            <td>@(c.User?.FullName ?? "—")</td>
                            <td class="text-muted small">@(c.User?.PhoneNumber ?? "—")</td>
                            <td class="text-center">@c.StartDate.ToString("dd/MM/yyyy")</td>
                            <td class="text-center @(isExpiringSoon ? "text-danger fw-bold" : "")">
                                @c.EndDate.ToString("dd/MM/yyyy")
                                @if (isExpiringSoon)
                                {
                                    <br/><span class="badge bg-danger" style="font-size:10px">Còn @daysLeft ngày</span>
                                }
                            </td>
                            <td class="text-end fw-semibold text-primary">@c.MonthlyRent.ToString("N0")</td>
                            <td class="text-end">@((c.Deposit ?? 0).ToString("N0"))</td>
                            <td class="text-center">@Html.Raw(statusBadge)</td>
                        </tr>
                    }
                </tbody>
                @if (Model.Any())
                {
                    <tfoot class="table-light fw-bold">
                        <tr>
                            <td colspan="7" class="text-end">Tổng cộng:</td>
                            <td class="text-end text-primary">@(Model.Sum(c => c.MonthlyRent).ToString("N0"))</td>
                            <td class="text-end">@(Model.Sum(c => c.Deposit ?? 0).ToString("N0"))</td>
                            <td></td>
                        </tr>
                    </tfoot>
                }
            </table>
        </div>
    </div>
</div>
