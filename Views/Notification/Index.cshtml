@model QuanLyPhongTro.Models.ViewModels.NotificationIndexViewModel
@using QuanLyPhongTro.Models
@{
    ViewData["Title"] = Model.IsAdmin ? "Gửi thông báo" : "Thông báo của tôi";
}

<div class="page-heading d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1"><i class="fas fa-bell text-warning me-2"></i>@ViewData["Title"]</h2>
        <p class="text-muted mb-0">Thông tin hợp đồng, thanh toán và lịch tạm ngừng điện nước.</p>
    </div>
    @if (!Model.IsAdmin && Model.Notifications.Any(n => n.ReadAt == null))
    {
        <form asp-action="MarkAllRead" method="post">
            @Html.AntiForgeryToken()
            <button class="btn btn-outline-primary" type="submit"><i class="fas fa-check-double me-1"></i> Đánh dấu đã đọc tất cả</button>
        </form>
    }
</div>

@if (Model.IsAdmin)
{
    <div class="card mb-4">
        <div class="card-header"><i class="fas fa-paper-plane me-2 text-primary"></i>Tạo thông báo</div>
        <div class="card-body">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="CreateModel.TargetUserId" class="form-label"></label>
                        <select asp-for="CreateModel.TargetUserId" asp-items="Model.Users" class="form-select"></select>
                        <span asp-validation-for="CreateModel.TargetUserId" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="CreateModel.Type" class="form-label"></label>
                        <select asp-for="CreateModel.Type" class="form-select">
                            <option value="0">Thông báo chung</option>
                            <option value="1">Hợp đồng / thanh toán</option>
                            <option value="2">Lịch cắt điện nước</option>
                        </select>
                    </div>
                    <div class="col-md-8">
                        <label asp-for="CreateModel.Title" class="form-label"></label>
                        <input asp-for="CreateModel.Title" class="form-control" placeholder="Ví dụ: Nhắc hạn thanh toán tháng 8" />
                        <span asp-validation-for="CreateModel.Title" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="CreateModel.EventDate" class="form-label"></label>
                        <input asp-for="CreateModel.EventDate" class="form-control" />
                    </div>
                    <div class="col-12">
                        <label asp-for="CreateModel.Content" class="form-label"></label>
                        <textarea asp-for="CreateModel.Content" class="form-control" rows="4"
                                  placeholder="Nội dung chi tiết người thuê cần biết..."></textarea>
                        <span asp-validation-for="CreateModel.Content" class="text-danger small"></span>
                    </div>
                    <div class="col-12 text-end">
                        <button class="btn btn-primary" type="submit"><i class="fas fa-paper-plane me-1"></i> Gửi thông báo</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
}

<div class="card">
    <div class="card-header d-flex justify-content-between">
        <span><i class="fas fa-inbox me-2"></i>@(Model.IsAdmin ? "Thông báo đã gửi gần đây" : "Danh sách thông báo")</span>
        <span class="badge bg-secondary">@Model.Notifications.Count</span>
    </div>
    <div class="card-body">
        @if (!Model.Notifications.Any())
        {
            <div class="text-center text-muted py-5"><i class="far fa-bell fa-3x d-block mb-3"></i>Chưa có thông báo nào.</div>
        }
        else
        {
            <div class="d-grid gap-3">
            @foreach (var item in Model.Notifications)
            {
                var typeInfo = item.Type switch
                {
                    UserNotificationType.HopDong => ("file-contract", "primary", "Hợp đồng / thanh toán"),
                    UserNotificationType.CatDienNuoc => ("bolt", "danger", "Điện nước"),
                    _ => ("bullhorn", "info", "Thông báo chung")
                };
                <article class="notification-card border rounded-3 p-3 @(item.ReadAt == null && !Model.IsAdmin ? "notification-unread" : "")">
                    <div class="d-flex gap-3">
                        <div class="notification-icon bg-@typeInfo.Item2-subtle text-@typeInfo.Item2">
                            <i class="fas fa-@typeInfo.Item1"></i>
                        </div>
                        <div class="flex-grow-1">
                            <div class="d-flex flex-wrap justify-content-between gap-2">
                                <div>
                                    <span class="badge bg-@typeInfo.Item2 mb-1">@typeInfo.Item3</span>
                                    @if (item.ReadAt == null && !Model.IsAdmin) { <span class="badge bg-warning text-dark mb-1">Mới</span> }
                                    <h5 class="mb-1">@item.Title</h5>
                                </div>
                                <div class="small text-muted text-end">
                                    @item.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                    @if (Model.IsAdmin) { <div>Đến: <strong>@item.User?.FullName</strong></div> }
                                </div>
                            </div>
                            <p class="mb-2" style="white-space:pre-line">@item.Content</p>
                            @if (item.EventDate.HasValue)
                            {
                                <div class="small fw-semibold text-danger"><i class="far fa-calendar-alt me-1"></i> Thời gian: @item.EventDate.Value.ToString("dd/MM/yyyy HH:mm")</div>
                            }
                            @if (!Model.IsAdmin && item.ReadAt == null)
                            {
                                <form asp-action="MarkRead" method="post" class="mt-2">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button class="btn btn-sm btn-outline-primary" type="submit"><i class="fas fa-check me-1"></i> Đã đọc</button>
                                </form>
                            }
                        </div>
                    </div>
                </article>
            }
            </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
