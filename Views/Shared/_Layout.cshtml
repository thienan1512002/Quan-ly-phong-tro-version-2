<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StayFlow</title>
    <!-- CoreUI CSS -->
    <link href="https://unpkg.com/@@coreui/coreui@5.4.0/dist/css/coreui.min.css" rel="stylesheet" />
    <!-- DevExtreme CSS -->
    <link rel="stylesheet" type="text/css"
          href="https://cdn3.devexpress.com/jslib/23.2.5/css/dx.material.blue.light.compact.css" />
    <!-- Font Icons -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <!-- jQuery (required by DevExtreme) -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <!-- CoreUI JS -->
    <script src="https://unpkg.com/@@coreui/coreui@5.4.0/dist/js/coreui.bundle.min.js"></script>
    <!-- DevExtreme JS -->
    <script src="https://cdn3.devexpress.com/jslib/23.2.5/js/dx.all.js"></script>
    <!-- SignalR -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        window._swalConfirmImg='https://cdn1.iconfinder.com/data/icons/interface-145/32/question-user_interface-ui-question_mark-website-help-element-512.png';
    </script>
    <style>
        body {
        background-color: #f8f9fa;
        }

        .sidebar {
        min-height: 100vh;
        background: #fffdf8;
        }

        .sidebar .nav-link {
        color: #b8bec7;
        padding: 10px 20px;
        }

        .sidebar .nav-link:hover,
        .sidebar .nav-link.active {
        color: #fff;
        background: rgba(255, 255, 255, 0.1);
        }

        .sidebar .nav-link i {
        margin-right: 8px;
        width: 20px;
        }

        .sidebar-brand {
        padding: 20px;
        color: #fff;
        font-size: 1.2rem;
        font-weight: bold;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }

        .main-content {
        padding: 20px;
        }

        .card {
        border: none;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        border-radius: 8px;
        }

        .card-header {
        background: #fff;
        border-bottom: 1px solid #eee;
        font-weight: 600;
        }

        #notificationArea {
        position: fixed;
        top: 20px;
        right: 20px;
        z-index: 9999;
        }

        /* Fix: DevExtreme material theme overrides Bootstrap button text color */
        .btn-primary,
        .btn-secondary,
        .btn-success,
        .btn-danger,
        .btn-warning,
        .btn-info,
        .btn-dark {
        color: #fff !important;
        }

        .btn-outline-primary:hover,
        .btn-outline-secondary:hover,
        .btn-outline-success:hover,
        .btn-outline-danger:hover,
        .btn-outline-warning:hover,
        .btn-outline-info:hover {
        color: #fff !important;
        }

        .btn-warning {
        color: #fff !important;
        }
    </style>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @if (ViewData["DashboardPage"] is true)
    {
        <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    }
</head>
<body class="dx-viewport @(ViewData["DashboardPage"] is true ? "dashboard-shell" : "")">
    @if (User.Identity?.IsAuthenticated == true)
    {
        @if (ViewData["DashboardPage"] is true)
        {
            <a class="dashboard-skip" href="#dashboard-main">Đến nội dung chính</a>
        }
        <header class="mobile-topbar d-md-none">
            <a class="mobile-brand" asp-controller="Dashboard" asp-action="Index">
                <i class="fas fa-layer-group"></i>
                <span>StayFlow</span>
            </a>
            <button class="btn btn-light btn-sm" type="button" data-coreui-toggle="collapse" data-coreui-target="#mobileNav"
                    aria-controls="mobileNav" aria-expanded="false" aria-label="Mở menu">
                <i class="fas fa-bars"></i>
            </button>
        </header>
        <div class="collapse mobile-nav d-md-none" id="mobileNav">
            <a class="mobile-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")"
               asp-controller="Dashboard" asp-action="Index">
                <i class="fas fa-tachometer-alt"></i> Dashboard
            </a>
            @if (User.IsInRole("Admin"))
            {
                <a class="mobile-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Room" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")"
                   asp-controller="Room" asp-action="Index">
                    <i class="fas fa-door-open"></i> Quản lý phòng
                </a>
            }
            <a class="mobile-nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "SearchPage" ? "active" : "")"
               asp-controller="Room" asp-action="SearchPage">
                <i class="fas fa-search"></i> Tìm kiếm phòng
            </a>
            <a class="mobile-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "RentalRequest" ? "active" : "")"
               asp-controller="RentalRequest" asp-action="Index">
                <i class="fas fa-clipboard-list"></i> Yêu cầu thuê
            </a>
            <a class="mobile-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Maintenance" ? "active" : "")"
               asp-controller="Maintenance" asp-action="Index">
                <i class="fas fa-screwdriver-wrench"></i> @(User.IsInRole("Admin") ? "Quản lý sửa chữa" : "Yêu cầu sửa chữa")
            </a>
            <a class="mobile-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Notification" ? "active" : "")"
               asp-controller="Notification" asp-action="Index">
                <i class="fas fa-bell"></i> Thông báo
                @if (User.IsInRole("User")) { <span class="badge bg-danger notification-count-badge d-none">0</span> }
            </a>
            <a class="mobile-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Utility" ? "active" : "")"
               asp-controller="Utility" asp-action="Index">
                <i class="fas fa-chart-column"></i> Điện nước theo tháng
            </a>
            @if (User.IsInRole("Admin"))
            {
                <a class="mobile-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Contract" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")"
                   asp-controller="Contract" asp-action="Index">
                    <i class="fas fa-file-contract"></i> Hợp đồng
                </a>
                <a class="mobile-nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "CalendarView" ? "active" : "")"
                   asp-controller="Contract" asp-action="CalendarView">
                    <i class="fas fa-calendar-alt"></i> Lịch thuê phòng
                </a>
                <a class="mobile-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Report" ? "active" : "")"
                   asp-controller="Report" asp-action="Index">
                    <i class="fas fa-chart-line"></i> Báo cáo
                </a>
            }
            <form asp-controller="Account" asp-action="Logout" method="post" class="mobile-nav-form">
                @Html.AntiForgeryToken()
                <button type="submit" class="mobile-nav-link mobile-nav-button">
                    <i class="fas fa-sign-out-alt"></i> Đăng xuất
                </button>
            </form>
        </div>

        <div class="app-shell d-flex">
            <!-- Sidebar -->
            <nav class="sidebar d-none d-md-flex flex-column" style="width:250px; min-width:250px;">
                <div class="sidebar-brand">
                    <i class="fas fa-layer-group"></i> StayFlow
                </div>
                @if (ViewData["DashboardPage"] is true)
                {
                    <div class="dashboard-nav-caption">KHÔNG GIAN QUẢN LÝ</div>
                }
                <ul class="nav flex-column mt-2">
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")"
                           asp-controller="Dashboard" asp-action="Index">
                            <i class="fas fa-tachometer-alt"></i> Dashboard
                        </a>
                    </li>
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Room" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")"
                               asp-controller="Room" asp-action="Index">
                                <i class="fas fa-door-open"></i> Quản lý phòng
                            </a>
                        </li>
                    }
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "SearchPage" ? "active" : "")"
                           asp-controller="Room" asp-action="SearchPage">
                            <i class="fas fa-search"></i> Tìm kiếm phòng
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "RentalRequest" ? "active" : "")"
                           asp-controller="RentalRequest" asp-action="Index">
                            <i class="fas fa-clipboard-list"></i> Yêu cầu thuê
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Maintenance" ? "active" : "")"
                           asp-controller="Maintenance" asp-action="Index">
                            <i class="fas fa-screwdriver-wrench"></i> @(User.IsInRole("Admin") ? "Quản lý sửa chữa" : "Yêu cầu sửa chữa")
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Notification" ? "active" : "")"
                           asp-controller="Notification" asp-action="Index">
                            <i class="fas fa-bell"></i> Thông báo
                            @if (User.IsInRole("User")) { <span class="badge bg-danger ms-1 notification-count-badge d-none">0</span> }
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Utility" ? "active" : "")"
                           asp-controller="Utility" asp-action="Index">
                            <i class="fas fa-chart-column"></i> Điện nước theo tháng
                        </a>
                    </li>
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Contract" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")"
                               asp-controller="Contract" asp-action="Index">
                                <i class="fas fa-file-contract"></i> Hợp đồng
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "CalendarView" ? "active" : "")"
                               asp-controller="Contract" asp-action="CalendarView">
                                <i class="fas fa-calendar-alt"></i> Lịch thuê phòng
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Report" ? "active" : "")"
                               asp-controller="Report" asp-action="Index">
                                <i class="fas fa-chart-line"></i> Báo cáo
                            </a>
                        </li>
                    }
                    <li class="nav-item mt-3 border-top border-secondary pt-2">
                        <span class="nav-link text-muted" style="font-size:0.85rem;">
                            <i class="fas fa-user"></i> @User.FindFirst("FullName")?.Value
                            <span
                            class="badge bg-info ms-1">@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</span>
                        </span>
                    </li>
                    <li class="nav-item">
                        <form asp-controller="Account" asp-action="Logout" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="nav-link btn btn-link text-start w-100" style="color:#b8bec7;">
                                <i class="fas fa-sign-out-alt"></i> Đăng xuất
                            </button>
                        </form>
                    </li>
                </ul>
            </nav>

            <!-- Main Content -->
            <div class="flex-grow-1 workspace-content">
                @if (ViewData["DashboardPage"] is true)
                {
                    var accountName = User.FindFirst("FullName")?.Value ?? User.Identity?.Name ?? "Tài khoản";
                    var initial = string.IsNullOrWhiteSpace(accountName) ? "S" : System.Globalization.StringInfo.GetNextTextElement(accountName.Trim()).ToUpperInvariant();
                    <header class="workspace-topbar">
                        <div class="workspace-breadcrumb"><span>StayFlow</span><i class="fas fa-chevron-right" aria-hidden="true"></i><strong>Tổng quan</strong></div>
                        <div class="workspace-account">
                            <a asp-controller="Room" asp-action="SearchPage" class="workspace-search"><i class="fas fa-search" aria-hidden="true"></i><span>Tìm phòng</span></a>
                            <a asp-controller="Notification" asp-action="Index" class="workspace-notifications" aria-label="Xem thông báo"><i class="far fa-bell" aria-hidden="true"></i>@if (User.IsInRole("User")) { <span class="badge bg-danger notification-count-badge d-none">0</span> }</a>
                            <span class="workspace-avatar" aria-hidden="true">@initial</span>
                            <div class="workspace-profile"><strong>@accountName</strong><small>@(User.IsInRole("Admin") ? "Quản trị viên" : "Người thuê")</small></div>
                        </div>
                    </header>
                }
                <div class="main-content">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="fas fa-check-circle me-2"></i> @TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="fas fa-exclamation-circle me-2"></i> @TempData["Error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }
                    @RenderBody()
                </div>
            </div>
        </div>
    }
    else
    {
        @RenderBody()
    }

    <!-- Notification Area (SignalR Toast) -->
    <div id="notificationArea"></div>



    @if (User.Identity?.IsAuthenticated == true)
    {
        <script>
            // =====================================================
            // SIGNALR CLIENT SETUP
            // =====================================================
            const connection=new signalR.HubConnectionBuilder()
            .withUrl("/notificationHub")
            .withAutomaticReconnect()
            .build();

            // Event: yêu cầu reload danh sách phòng
            connection.on("reloadRooms", function () {
            if (typeof reloadRoomGrid==="function") {
            reloadRoomGrid(); // gọi hàm reload nếu đang ở trang phòng
            }
            });

            // Event: có yêu cầu thuê mới
            connection.on("newRequest", function (roomName, userName) {
            showToast("Yêu cầu mới!", userName+" muốn thuê phòng <b>"+roomName+"</b>");
            });

            // Event: chủ trọ gửi thông báo mới cho người thuê
            connection.on("ownerNotification", function (title) {
            showToast("Thông báo từ chủ trọ", escapeHtml(title));
            refreshNotificationCount();
            });

            connection.start()
            .then(() => console.log("✅ SignalR connected"))
            .catch(err => console.error("❌ SignalR error:", err));

            // Hiển thị toast notification đẹp
            function showToast(title, message) {
            const id="t"+Date.now();
            const el=document.createElement("div");
            el.id=id;
            el.className="toast show mb-2";
            el.style.minWidth="280px";
            el.innerHTML=`
            <div class="toast-header bg-primary text-white">
            <strong class="me-auto"><i class="fas fa-bell me-1"></i> ${title}</strong>
            <button type="button" class="btn-close btn-close-white" onclick="this.closest('.toast').remove()"></button>
            </div>
            <div class="toast-body">${message}</div>`;
            document.getElementById("notificationArea").appendChild(el);
            setTimeout(() => el.remove(), 5000);
            }

            function escapeHtml(value) {
            const element=document.createElement('div');
            element.textContent=value ?? '';
            return element.innerHTML;
            }

            function refreshNotificationCount() {
            const badges=document.querySelectorAll('.notification-count-badge');
            if (!badges.length) return;
            fetch('/Notification/UnreadCount', { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(response => response.ok ? response.json() : null)
            .then(data => {
            if (!data) return;
            badges.forEach(badge => {
            badge.textContent=data.count;
            badge.classList.toggle('d-none', data.count===0);
            });
            })
            .catch(() => {});
            }

            refreshNotificationCount();
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
