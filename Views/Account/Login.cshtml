@{
    Layout = null; // Trang login không dùng layout chính
    ViewData["Title"] = "Đăng nhập";
}
@model QuanLyPhongTro.Models.ViewModels.LoginViewModel

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng nhập - StayFlow</title>
    <link href="https://unpkg.com/@@coreui/coreui@5.4.0/dist/css/coreui.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body { background: radial-gradient(circle at 18% 12%, rgba(250,231,220,.62), transparent 30rem), linear-gradient(135deg, #f6f1ea, #dff3e8); min-height: 100vh; display: flex; align-items: center; }
        .login-card { max-width: 400px; width: 100%; margin: 0 auto; }
        .login-card .card { border: 1px solid #e5ded2; border-radius: 8px; box-shadow: 0 22px 56px rgba(72,58,40,.18); }
        .login-header { background: linear-gradient(135deg, #1f7a5a, #c96f4a); color: white; padding: 30px; border-radius: 8px 8px 0 0; text-align: center; }
    </style>
</head>
<body>
    <div class="login-card px-3">
        <div class="card">
            <div class="login-header">
                <i class="fas fa-layer-group fa-3x mb-3"></i>
                <h4 class="mb-0">StayFlow</h4>
                <p class="mb-0 opacity-75">Đăng nhập vào không gian quản lý</p>
            </div>
            <div class="card-body p-4">
                <form asp-controller="Account" asp-action="Login" method="post">
                    @Html.AntiForgeryToken()

                    <!-- Hiển thị lỗi tổng -->
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            @Html.ValidationSummary(true)
                        </div>
                    }

                    <!-- Input tên đăng nhập -->
                    <div class="mb-3">
                        <label asp-for="Username" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-user"></i></span>
                            <input asp-for="Username" class="form-control" placeholder="Nhập tên đăng nhập" />
                        </div>
                        <span asp-validation-for="Username" class="text-danger small"></span>
                    </div>

                    <!-- Input mật khẩu -->
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-lock"></i></span>
                            <input asp-for="Password" class="form-control" placeholder="Nhập mật khẩu" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <!-- Checkbox ghi nhớ đăng nhập -->
                    <div class="mb-3 form-check">
                        <input asp-for="RememberMe" class="form-check-input" type="checkbox" />
                        <label asp-for="RememberMe" class="form-check-label">Ghi nhớ đăng nhập</label>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fas fa-sign-in-alt me-2"></i> Đăng nhập
                    </button>
                </form>

              

                <hr class="my-3" />
                <div class="text-center" style="font-size:0.9rem">
                    Chưa có tài khoản?
                    <a asp-controller="Account" asp-action="Register" class="fw-semibold">Đăng ký ngay</a>
                </div>
            </div>
        </div>
    </div>

    <script src="https://unpkg.com/@@coreui/coreui@5.4.0/dist/js/coreui.bundle.min.js"></script>
</body>
</html>
